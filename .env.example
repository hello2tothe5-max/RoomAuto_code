# ============================================================
# RoomAuto 환경 변수 설정 파일 (이 파일을 복사해서 .env로 만드세요)
#
#   cp .env.example .env
# ============================================================

# 서버 포트 (기본 3000)
PORT=3000

# 세션 비밀번호 - 아무 긴 문자열이나 넣으면 됩니다
SESSION_SECRET=roomauto-secret-key

# ------------------------------------------------------------
# 구글 로그인 설정 (선택)
# https://console.cloud.google.com/ 에서 OAuth 클라이언트 만들기
# 1. OAuth 동의 화면 설정
# 2. 사용자 인증 정보 > OAuth 클라이언트 ID 만들기
# 3. 승인된 리다이렉트 URI에 아래 주소를 등록
#    http://localhost:3000/auth/google/callback
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=여기에-클라이언트-ID-입력
# GOOGLE_CLIENT_SECRET=여기에-시크릿-입력

# ------------------------------------------------------------
# 깃허브 로그인 설정 (선택)
# https://github.com/settings/developers 에서 OAuth App 만들기
# 1. New OAuth App 클릭
# 2. Authorization callback URL에 아래 주소를 등록
#    http://localhost:3000/auth/github/callback
# ------------------------------------------------------------
# GITHUB_CLIENT_ID=여기에-클라이언트-ID-입력
# GITHUB_CLIENT_SECRET=여기에-시크릿-입력
